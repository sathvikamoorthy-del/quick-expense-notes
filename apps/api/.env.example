# Copy to .env (git-ignored). Modules append their keys.

# jwt-auth / sign-in (WI-039): a random string of at least 32 characters; signs and verifies the 60-minute tokens
JWT_SECRET=
# Seed (python -m scripts.seed_users): password of the demo user asha@example.com, at least 8 characters
DEMO_USER_PASSWORD=
# AI help for plain-words entries (REQ-438, WI-066). Without a key, plain-words lines show "AI help is not available right now."
ANTHROPIC_API_KEY=
# The Claude model of the AI call (product owner, 23 Nov 2026: Claude Haiku 5.5)
ANTHROPIC_MODEL=claude-haiku-5-5
# Seconds before one AI call gives up, and how many times it is retried
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
