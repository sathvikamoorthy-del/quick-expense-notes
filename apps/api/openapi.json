{
  "components": {
    "schemas": {
      "CategoryTotalModel": {
        "properties": {
          "category": {
            "description": "Category name, e.g. Food",
            "title": "Category",
            "type": "string"
          },
          "code": {
            "description": "Category code, e.g. F",
            "title": "Code",
            "type": "string"
          },
          "total": {
            "description": "Rupees with 2 decimals, e.g. 590.00",
            "title": "Total",
            "type": "string"
          },
          "total_paise": {
            "title": "Total Paise",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "category",
          "total",
          "total_paise"
        ],
        "title": "CategoryTotalModel",
        "type": "object"
      },
      "EditRequest": {
        "description": "One short entry replacing the saved one, e.g. `UBR 220 12/11 airport`.",
        "properties": {
          "text": {
            "description": "One short entry, e.g. `SWG 340 yd`.",
            "maxLength": 500,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EditRequest",
        "type": "object"
      },
      "EditResponse": {
        "properties": {
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SavedEntry"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "ok": {
            "description": "false when the edit was refused (error says why); the entry is then unchanged.",
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "EditResponse",
        "type": "object"
      },
      "ExpandAllRequest": {
        "properties": {
          "text": {
            "description": "Several short entries separated by new lines or semicolons.",
            "maxLength": 10500,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ExpandAllRequest",
        "type": "object"
      },
      "ExpandAllResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "ok": {
            "description": "false when the whole text box is rejected (error says why, results is empty).",
            "title": "Ok",
            "type": "boolean"
          },
          "results": {
            "description": "One result per entry, in typed order.",
            "items": {
              "$ref": "#/components/schemas/ExpandResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "ok"
        ],
        "title": "ExpandAllResponse",
        "type": "object"
      },
      "ExpandRequest": {
        "properties": {
          "text": {
            "description": "One short entry, e.g. `SWG 340 yd`.",
            "maxLength": 500,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ExpandRequest",
        "type": "object"
      },
      "ExpandResponse": {
        "properties": {
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpandedEntry"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "ExpandResponse",
        "type": "object"
      },
      "ExpandResult": {
        "properties": {
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpandedEntry"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "typed": {
            "description": "The entry as typed, trimmed.",
            "title": "Typed",
            "type": "string"
          }
        },
        "required": [
          "typed",
          "ok"
        ],
        "title": "ExpandResult",
        "type": "object"
      },
      "ExpandedEntry": {
        "properties": {
          "amount": {
            "description": "Rupees with 2 decimals, e.g. 340.00",
            "title": "Amount",
            "type": "string"
          },
          "amount_paise": {
            "title": "Amount Paise",
            "type": "integer"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "merchant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "code",
          "merchant",
          "category",
          "amount",
          "amount_paise",
          "date",
          "note"
        ],
        "title": "ExpandedEntry",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SaveRequest": {
        "properties": {
          "reviewed": {
            "description": "The results of /entries/expand-all that the user reviewed, unchanged.",
            "items": {
              "$ref": "#/components/schemas/ExpandResult"
            },
            "maxItems": 20,
            "title": "Reviewed",
            "type": "array"
          },
          "text": {
            "description": "Several short entries separated by new lines or semicolons.",
            "maxLength": 10500,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "reviewed"
        ],
        "title": "SaveRequest",
        "type": "object"
      },
      "SaveResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "failed": {
            "description": "The entries not saved, with their errors.",
            "items": {
              "$ref": "#/components/schemas/ExpandResult"
            },
            "title": "Failed",
            "type": "array"
          },
          "ids": {
            "description": "The ids of the saved expense records.",
            "items": {
              "type": "string"
            },
            "title": "Ids",
            "type": "array"
          },
          "ok": {
            "description": "false when nothing was saved (error says why).",
            "title": "Ok",
            "type": "boolean"
          },
          "saved": {
            "default": 0,
            "description": "How many entries were saved as expense records.",
            "title": "Saved",
            "type": "integer"
          }
        },
        "required": [
          "ok"
        ],
        "title": "SaveResponse",
        "type": "object"
      },
      "SavedEntriesResponse": {
        "properties": {
          "current_month": {
            "description": "The current month in IST, YYYY-MM: the latest month that can be opened.",
            "title": "Current Month",
            "type": "string"
          },
          "entries": {
            "description": "The user's entries of the month, newest date first.",
            "items": {
              "$ref": "#/components/schemas/SavedEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "month": {
            "description": "The month shown, YYYY-MM.",
            "title": "Month",
            "type": "string"
          }
        },
        "required": [
          "month",
          "current_month",
          "entries"
        ],
        "title": "SavedEntriesResponse",
        "type": "object"
      },
      "SavedEntry": {
        "properties": {
          "amount": {
            "description": "Rupees with 2 decimals, e.g. 340.00",
            "title": "Amount",
            "type": "string"
          },
          "amount_paise": {
            "title": "Amount Paise",
            "type": "integer"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "merchant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "typed": {
            "description": "The short entry as typed, e.g. `SWG 340 yd`: the pre-fill of an edit.",
            "title": "Typed",
            "type": "string"
          }
        },
        "required": [
          "id",
          "typed",
          "code",
          "merchant",
          "category",
          "amount",
          "amount_paise",
          "date",
          "note"
        ],
        "title": "SavedEntry",
        "type": "object"
      },
      "SignInRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "SignInResponse": {
        "properties": {
          "expires_in": {
            "description": "Seconds until the token expires (3600).",
            "title": "Expires In",
            "type": "integer"
          },
          "token": {
            "title": "Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SignedInUser"
          }
        },
        "required": [
          "token",
          "expires_in",
          "user"
        ],
        "title": "SignInResponse",
        "type": "object"
      },
      "SignedInUser": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "title": "SignedInUser",
        "type": "object"
      },
      "SummaryResponse": {
        "properties": {
          "categories": {
            "description": "One total per category with entries, in the fixed category order; empty when the month has none.",
            "items": {
              "$ref": "#/components/schemas/CategoryTotalModel"
            },
            "title": "Categories",
            "type": "array"
          },
          "current_month": {
            "description": "The current month in IST, YYYY-MM: the latest month that can be opened.",
            "title": "Current Month",
            "type": "string"
          },
          "grand_total": {
            "title": "Grand Total",
            "type": "string"
          },
          "grand_total_paise": {
            "title": "Grand Total Paise",
            "type": "integer"
          },
          "month": {
            "description": "The month shown, YYYY-MM.",
            "title": "Month",
            "type": "string"
          }
        },
        "required": [
          "month",
          "current_month",
          "categories",
          "grand_total",
          "grand_total_paise"
        ],
        "title": "SummaryResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/sign-in": {
      "post": {
        "operationId": "sign_in_route_auth_sign_in_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid email or password."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign In Route",
        "tags": [
          "auth"
        ]
      }
    },
    "/entries": {
      "get": {
        "operationId": "saved_entries_entries_get",
        "parameters": [
          {
            "description": "YYYY-MM; the current IST month when left out.",
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM; the current IST month when left out.",
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedEntriesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Saved Entries",
        "tags": [
          "entries"
        ]
      }
    },
    "/entries/expand": {
      "post": {
        "operationId": "expand_entry_entries_expand_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpandResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Expand Entry",
        "tags": [
          "entries"
        ]
      }
    },
    "/entries/expand-all": {
      "post": {
        "operationId": "expand_all_entries_entries_expand_all_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpandAllRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpandAllResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Expand All Entries",
        "tags": [
          "entries"
        ]
      }
    },
    "/entries/save": {
      "post": {
        "operationId": "save_entries_entries_save_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Entries",
        "tags": [
          "entries"
        ]
      }
    },
    "/entries/{expense_id}": {
      "put": {
        "operationId": "edit_saved_entry_entries__expense_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "expense_id",
            "required": true,
            "schema": {
              "title": "Expense Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Edit Saved Entry",
        "tags": [
          "entries"
        ]
      }
    },
    "/summary": {
      "get": {
        "operationId": "summary_summary_get",
        "parameters": [
          {
            "description": "YYYY-MM; the current IST month when left out.",
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM; the current IST month when left out.",
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Summary",
        "tags": [
          "entries"
        ]
      }
    }
  }
}
