{
  "components": {
    "schemas": {
      "ExpandRequest": {
        "properties": {
          "text": {
            "description": "One short entry, e.g. `SWG 340 yd`.",
            "maxLength": 500,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ExpandRequest",
        "type": "object"
      },
      "ExpandResponse": {
        "properties": {
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpandedEntry"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "ExpandResponse",
        "type": "object"
      },
      "ExpandedEntry": {
        "properties": {
